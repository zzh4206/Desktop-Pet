# ============================================================
# 以下为本仓库项目规则（2026-10-03 整理；通用模板段见上）
# 原则：生成产物一律不入库，历史提交中的旧产物可从 git 历史找回。
# ============================================================

# ---- 编辑器 / 工具私有目录 ----
.claude/*
.mimosa/*
.zcode/*
.commandcode
.idea/

# ---- macOS ----
.DS_Store

# ---- 本地配置与数据 ----
config.json
data/

# ---- 本地测试（本地跑，不入库）----
tests/

# ---- 本地工作文档（个人 working notes，不推送）----
mac任务清单.md
v0.*测试样例.md
llm-wiki.md
CLAUDE.md

# ---- 生成产物（只留在本地，不入库）----
# 运行/复查产出的带日期 GIF、帧序列与证据媒体
output/
spikes/_qa/
.scratch/

# 资源监控诊断产物（CPU/内存采样 CSV、vmmap 快照、全内存分析脚本）
tools/monitor_pet_*.csv
tools/monitor_pet_*.vmmap.txt
tools/analyze_fullmem.py

# 生成候选（未签字产物，如 exp/pipeline-v2 的 VACE 候选等）
assets/*/candidates/

# ---- 大体积资产源 / 原始素材（见 docs/ADULT转身视频过渡与侧身骨骼行走方案-2026-09-27.md）----
# 原始视频与生成候选体积大，不入库；只入库定稿帧、生成记录与门禁证据
assets/rig_adult_walk_v1/**/raw/
assets/rig_final_walk_v1/clips/raw/
assets/rig_adult_walk_v1/**/*.mp4

# rig 部件资产目录是入库例外（防 v0.13.0 式静默漏交：
# 上方模板 Python 段的 parts/ 规则会误伤 assets/rig/**/parts/，此处白名单兜底）
!assets/rig/**/parts/
!assets/rig/**/parts/**

# ---- three_d 实验线 ----
# DCC 资产源（.blend/.ma/VRM/贴图 PSD/图板导出等大文件，本地开发用，
# 不随仓库/安装包分发；three_d/wiki/ 照常入库。运行时代码在 pet/render3d/，另行入库）
three_d/assets_src/

# spike 派生资产（Balsam 产物与截图，源在 assets_src/ 或可重生）
three_d/spikes/*/assets/
three_d/spikes/*/shot_*.png
three_d/spikes/*/gallery_*.png
three_d/spikes/*/runtime_preview_*.png
three_d_assets/
